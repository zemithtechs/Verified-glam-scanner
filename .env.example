# Copy to .env (never commit .env). Flutter needs --dart-define at run time.
# Use scripts/run-dev.ps1 to load .env automatically.

# Live backend (Cloudflare Worker) — required by mobile and web builds.
VG_API_URL=https://verified-glam-api.komolafephilip.workers.dev

# E2E script (scripts/test-web-tools-e2e.ps1) — dedicated test account, not production users
TEST_USER_EMAIL=your_test_user@example.com
TEST_USER_PASSWORD=your_test_password

GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# --- Cloudflare environment variables ---
# VG_API_URL and GOOGLE_WEB_CLIENT_ID are public build-time configuration.
# FCM_SERVICE_ACCOUNT_JSON and API keys belong in Cloudflare Worker secrets.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Polar.sh (subscriptions — web + Android via hosted checkout; NOT client secrets)
# Set POLAR_ACCESS_TOKEN and POLAR_WEBHOOK_SECRET as Cloudflare Worker secrets only.
# POLAR_WEBHOOK_SECRET=polar_whs_…  ← paste EXACTLY from Polar → Webhooks → Signing secret
# Do NOT add whsec_ prefix. Do NOT modify the string.
# Organization ID: Polar Dashboard → Settings → Organization → "Unique identifier" (UUID)
POLAR_ORGANIZATION_ID=
# Slug shown in polar.sh/{slug}/portal (Settings → Organization slug)
POLAR_ORGANIZATION_SLUG=
POLAR_PRODUCT_ID_ANNUAL=9e185286-cf2b-41b8-a728-e7154d144722
POLAR_PRODUCT_ID_PRO_WEEKLY=8c9fddc9-1001-4143-8a27-31ce929ae5e6
# Optional guest-only fallback on the marketing site.
POLAR_CHECKOUT_LINK_ANNUAL=https://buy.polar.sh/polar_cl_dlK0Tq44DzEmuJh3i5AFkQdkfFQd4L8910MJT3YsdT1
POLAR_CHECKOUT_LINK_PRO_WEEKLY=https://buy.polar.sh/polar_cl_xBMQgfvP21DLP6lsJtMqBPCho8XZIg9QQS6D52jTWRv
# Post-payment redirect (API checkout). Default: app dashboard with ?checkout=success
POLAR_SUCCESS_URL=https://scanner.verifiedglam.com/app/face-beauty-analysis?checkout=success
POLAR_CANCEL_URL=https://scanner.verifiedglam.com/pricing?checkout=cancelled
# Optional origin override if domain changes
# POLAR_APP_BASE_URL=https://scanner.verifiedglam.com
POLAR_ENV=production

# Default path for scripts/setup-fcm-push.ps1 (optional local reference only; never commit the file)
# FCM_ADMINSDK_JSON_PATH=C:\path\to\firebase-adminsdk.json

# Optional: copy OPENAI_API_KEY here temporarily to run tools/test-openai-vision.ps1 locally (never commit)

# DataForSEO (Claude SEO extension — scripts/configure-dataforseo-mcp.ps1)
# Sign up: https://app.dataforseo.com/register
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=
