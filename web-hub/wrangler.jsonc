{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "ai-beauty-styling-web",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
	"routes": [
		{ "pattern": "aibeautystyling.com", "custom_domain": true },
		{ "pattern": "www.aibeautystyling.com", "custom_domain": true }
	],
	// Used only to re-encode uploaded photos (removes metadata) for the image tools.
	"images": { "binding": "IMAGES" },
	// Shared database with the main app: holds the free-result counters (tables from migration 0009).
	"d1_databases": [
		{ "binding": "DB", "database_name": "verified-glam-db", "database_id": "aaca0f9b-e21b-46ac-a35c-300e64375ecb" }
	],
	"vars": {
		"OPENAI_IMAGE_MODEL": "gpt-image-2.5-sunburst",
		// The shared account backend (sign-in, credits, saved results, payments).
		"WORKER_API_URL": "https://verified-glam-api.komolafephilip.workers.dev",
		// Free results per visitor per day, and the most free results the whole site will give per day.
		"FREE_RESULTS_PER_DAY": "2",
		"GLOBAL_RESULTS_PER_DAY": "100"
	},
	"observability": { "enabled": true }
}
