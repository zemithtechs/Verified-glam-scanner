# Server-side only. Never use NEXT_PUBLIC_ for an API key.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Set 0 to disable the local paid generation endpoint.
LOCAL_IMAGE_GENERATION=1
# Where the site's pictures are served from (public R2 bucket). Set it empty to use same-origin files from public/ instead.
NEXT_PUBLIC_IMAGE_BASE=https://images.aibeautystyling.com
